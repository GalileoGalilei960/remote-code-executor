{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "tsc: build",
            "type": "shell",
            "command": "pnpm",
            "args": ["run", "build"],
            "problemMatcher": ["$tsc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "tsc: watch",
            "type": "shell",
            "command": "pnpm",
            "args": ["run", "start:dev"],
            "isBackground": true,
            "problemMatcher": {
                "pattern": "$tsc",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*",
                    "endsPattern": "^.*waiting for file changes.*"
                }
            }
        }
    ]
}
