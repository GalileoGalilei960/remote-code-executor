{
    "name": "remote-code-executor",
    "version": "0.0.1",
    "description": "my pet project",
    "author": "GalileoGalilei960",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "NODE_OPTIONS='--experimental-vm-modules' DOCKER_HOST=unix:///run/user/$(id -u)/podman/podman.sock TESTCONTAINERS_RYUK_DISABLED=true jest --config ./test/jest-e2e.json"
    },
    "dependencies": {
        "@nestjs/bullmq": "^11.0.4",
        "@nestjs/common": "^11.1.17",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.1.21",
        "@nestjs/event-emitter": "^3.0.1",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/mapped-types": "^2.1.1",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.17",
        "@nestjs/platform-socket.io": "^11.1.18",
        "@nestjs/websockets": "^11.1.18",
        "@prisma/adapter-pg": "^7.5.0",
        "@prisma/client": "^7.5.0",
        "@types/bcrypt": "^6.0.0",
        "bcrypt": "^6.0.0",
        "bullmq": "^5.73.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "cookie-parser": "^1.4.7",
        "dockerode": "^4.0.10",
        "dotenv": "^17.3.1",
        "eventemitter2": "^6.4.9",
        "ioredis": "^5.10.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "socket.io": "^4.8.3",
        "tar-stream": "^3.1.8",
        "ua-parser-js": "^2.0.9",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^9.39.4",
        "@nestjs/cli": "^11.0.16",
        "@nestjs/schematics": "^11.0.9",
        "@nestjs/testing": "^11.1.17",
        "@testcontainers/postgresql": "^11.14.0",
        "@testcontainers/redis": "^11.14.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/dockerode": "^4.0.1",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.19.15",
        "@types/supertest": "^6.0.3",
        "@types/tar-stream": "^3.1.4",
        "@types/ua-parser-js": "^0.7.39",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "globals": "^16.5.0",
        "jest": "^30.3.0",
        "prettier": "^3.8.1",
        "prisma": "^7.5.0",
        "socket.io-client": "^4.8.3",
        "source-map-support": "^0.5.21",
        "supertest": "^7.2.2",
        "testcontainers": "^11.14.0",
        "ts-jest": "^29.4.6",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.57.2"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^(\\.{1,2}/.*)\\.js$": "$1",
            "^@/(.*)$": "<rootDir>/$1",
            "^src/(.*)$": "<rootDir>/$1",
            "^generated/(.*)$": "<rootDir>/../generated/$1"
        }
    },
    "pnpm": {
        "overrides": {
            "hono": "^4.12.18",
            "lodash": "^4.17.24",
            "picomatch": "^4.0.4",
            "path-to-regexp": "^8.4.0",
            "ajv": "^8.18.0",
            "@hono/node-server": "^1.19.13"
        }
    }
}
